<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    style="@style/ConsoleCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/artLayout"
            android:layout_width="0dp"
            android:layout_height="@dimen/console_art_height"
            android:background="@drawable/console_art_unknown"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/stateIndicatorImageView"
                android:layout_width="match_parent"
                android:layout_height="@dimen/console_image_height"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/console_image_offset"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_console_ps5_ready" />

            <TextView
                android:id="@+id/statusTextView"
                style="@style/StatusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:textColor="?attr/colorOnSurface"
                app:drawableStartCompat="@drawable/status_dot"
                tools:drawableTint="@color/state_ready"
                tools:text="Ready" />
        </FrameLayout>

        <TextView
            android:id="@+id/nameTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/artLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Living Room PS5" />

        <TextView
            android:id="@+id/hostTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintTop_toBottomOf="@id/nameTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="PS5 · 192.168.1.20" />

        <TextView
            android:id="@+id/bottomInfoTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorSecondary"
            app:layout_constraintTop_toBottomOf="@id/hostTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Playing Hogwarts Legacy" />

        <!-- Shows what selecting the card does; the card itself handles the click -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/primaryActionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="8dp"
            android:clickable="false"
            android:focusable="false"
            android:duplicateParentState="true"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toBottomOf="@id/bottomInfoTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/menuButton"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:icon="@drawable/ic_play"
            tools:text="Play" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuButton"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/colorSurfaceContainerHighest"
            app:iconTint="?attr/colorOnSurface"
            app:strokeColor="@color/console_card_stroke"
            app:strokeWidth="3dp"
            android:nextFocusLeft="@id/card"
            android:contentDescription="@string/action_more"
            app:icon="@drawable/ic_more_vert"
            app:layout_constraintTop_toTopOf="@id/primaryActionButton"
            app:layout_constraintBottom_toBottomOf="@id/primaryActionButton"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
